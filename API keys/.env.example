# Placeholders only — never put real secrets in this file.
# Canonical vault: ~/jarvis/secrets/api-keys.env
# This folder's .env symlinks there.
# REQUIRED = must be filled for the stack to work. OPTIONAL = fills a feature.

# ─────────────────────────────────────────────────────────────
# REQUIRED: OpenAI (Jarvis Realtime voice companion)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# REQUIRED: OpenRouter (one key for GLM, GPT, Claude, Gemini, DeepSeek)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# REQUIRED: Anthropic (Claude direct)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# REQUIRED: Google AI / Gemini
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
GEMINI_API_KEY=

# REQUIRED: DeepSeek
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# REQUIRED: Z.ai / GLM direct
# https://openai.z.ai/ → API keys
ZAI_API_KEY=
GLM_API_KEY=

# REQUIRED: Nous / Hermes (if not using Nous OAuth)
# Hermes currently runs via Nous OAuth without a separate key; keep empty unless required.
NOUS_API_KEY=
HERMES_API_KEY=

# REQUIRED: Cursor (if using Cursor API directly)
# Usually Cursor is signed in; only set if using Cursor API programmatically.
CURSOR_API_KEY=

# REQUIRED: Ollama Cloud (GLM 5.2 cloud) — run in Terminal: ollama signin
# This is not a pasteable key; it is a sign-in note.
OLLAMA_API_KEY=
OLLAMA_CLOUD=sign in with: ollama signin

# REQUIRED: Tailscale Admin API
# https://login.tailscale.com/admin/settings/keys
TAILSCALE_API_KEY=
TAILSCALE_TAILNET=-

# REQUIRED: xAI / Grok
# https://console.x.ai/
XAI_API_KEY=

# OPTIONAL: ElevenLabs (XI API) — voice clone / TTS
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
XI_API_KEY=

# OPTIONAL: Exa web search
# https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# OPTIONAL: Cloudflare API token
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=

# OPTIONAL: GitHub fine-grained PAT (or use `gh auth login`)
# https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
